/* App stylesheet. Dollar-sign placeholders are design tokens from theme/__init__.py;
   widgets opt into looks via the "role" and "variant" properties. */

QMainWindow, QDialog {
    background: $bg;
}

QToolTip {
    background: $raised;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 6px;
    padding: 6px 8px;
}

/* --- menus ------------------------------------------------------------ */

QMenuBar {
    background: $bg;
    border-bottom: 1px solid $border;
    padding: 3px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background: $hover;
}
QMenu {
    background: $surface;
    border: 1px solid $border_strong;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 6px;
}
QMenu::icon {
    padding-left: 10px;
}
QMenu::item:selected {
    background: $accent_soft;
    color: $text;
}
QMenu::item:disabled {
    color: $text_muted;
}
QMenu::separator {
    height: 1px;
    background: $border;
    margin: 5px 8px;
}

/* --- buttons ---------------------------------------------------------- */

QPushButton {
    background: $raised;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 18px;
    font-weight: 500;
}
QPushButton:hover {
    background: $hover;
}
QPushButton:pressed {
    background: $pressed;
}
QPushButton:checked {
    background: $accent_soft;
    border-color: $accent;
}
QPushButton:disabled {
    background: transparent;
    border-color: $border;
    color: $text_disabled;
}
QPushButton::menu-indicator {
    image: url("$chevron_down");
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    height: 12px;
    right: 10px;
}
QPushButton[hasMenu="true"] {
    padding-right: 30px;
}
QPushButton[variant="primary"]::menu-indicator {
    image: url("$chevron_on_accent");
}
QPushButton[variant="primary"] {
    background: $accent;
    border-color: $accent;
    color: $on_accent;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background: $accent_hover;
    border-color: $accent_hover;
}
QPushButton[variant="primary"]:disabled {
    background: $accent_soft;
    border-color: $accent_soft;
    color: $text_muted;
}
QPushButton[variant="ghost"], QPushButton[variant="danger"] {
    background: transparent;
    border-color: transparent;
}
QPushButton[variant="ghost"]:hover {
    background: $hover;
}
QPushButton[variant="danger"] {
    color: $danger;
}
QPushButton[variant="danger"]:hover {
    background: $hover;
    border-color: $border_strong;
}
QPushButton[variant="danger"]:disabled, QPushButton[variant="ghost"]:disabled {
    color: $text_disabled;
    border-color: transparent;
}
QPushButton[variant="disclosure"] {
    background: transparent;
    border: none;
    padding: 6px 2px;
    text-align: left;
    font-weight: 600;
}
QPushButton[variant="disclosure"]:hover {
    color: $accent;
}

/* --- inputs ----------------------------------------------------------- */

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox {
    background: $surface;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: $accent;
    selection-color: $on_accent;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QComboBox:on {
    border-color: $accent;
}
QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    color: $text_disabled;
    border-color: $border;
}
QComboBox {
    padding-right: 28px;
}
QComboBox:hover {
    background: $hover;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    image: url("$chevron_down");
    width: 14px;
    height: 14px;
}
QComboBox QAbstractItemView {
    background: $surface;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: $accent_soft;
    selection-color: $text;
}
QCheckBox {
    spacing: 8px;
}

/* --- tabs ------------------------------------------------------------- */

QTabWidget::pane {
    border: none;
    border-top: 1px solid $border;
    top: -1px;
    padding-top: 10px;
}
QTabBar::tab {
    background: transparent;
    color: $text_muted;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 14px;
    margin-right: 4px;
    font-weight: 500;
}
QTabBar::tab:hover {
    color: $text;
}
QTabBar::tab:selected {
    color: $text;
    border-bottom-color: $accent;
}

/* --- lists and tables ------------------------------------------------- */

QAbstractItemView {
    background: $surface;
    alternate-background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 10px;
    gridline-color: $border;
    selection-background-color: $accent_soft;
    selection-color: $text;
    outline: 0;
}
QTableView::item {
    padding: 0 8px;
}
QTableView::item:hover, QListView::item:hover {
    background: $hover;
}
QTableView::item:selected, QListView::item:selected {
    background: $accent_soft;
    color: $text;
}
QListView {
    padding: 4px;
}
QListView::item {
    padding: 7px 10px;
    border-radius: 6px;
}
QHeaderView {
    background: transparent;
}
QHeaderView::section {
    background: $surface;
    color: $text_muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: 8px;
    font-weight: 600;
}
QHeaderView::section:hover {
    color: $text;
}
QTableCornerButton::section {
    background: $surface;
    border: none;
}

/* --- scroll bars ------------------------------------------------------ */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle {
    background: $scroll;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::handle:hover {
    background: $scroll_hover;
}
QScrollBar::handle:vertical {
    min-height: 32px;
}
QScrollBar::handle:horizontal {
    min-width: 32px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* --- chrome ----------------------------------------------------------- */

QSplitter::handle {
    background: transparent;
}
QProgressBar {
    background: $surface_alt;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    min-height: 18px;
    text-align: center;
    font-weight: 500;
}
QProgressBar::chunk {
    background: $accent;
    border-radius: 5px;
}
QStatusBar {
    background: $bg;
    border-top: 1px solid $border;
    color: $text_muted;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: $text_muted;
    padding: 0 6px;
}

/* --- roles ------------------------------------------------------------ */

QFrame[role="card"] {
    background: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}
QFrame[role="card"] QAbstractItemView {
    border: none;
    border-radius: 0;
}
QLabel[role="title"] {
    font-size: ${title_px}px;
    font-weight: 600;
    color: $text;
}
QLabel[role="section"] {
    font-weight: 600;
    color: $text;
    padding-top: 6px;
}
QLabel[role="muted"] {
    color: $text_muted;
}
QLabel[role="warning"] {
    color: $warning;
    font-weight: 600;
    padding-top: 6px;
}
QLabel[role="pill"] {
    background: $surface_alt;
    color: $text_muted;
    border: 1px solid $border;
    border-radius: 10px;
    padding: 2px 9px;
}
QLabel[role="empty"] {
    color: $text_muted;
    font-size: ${base_px}px;
}
QLabel#toast {
    background: $toast_bg;
    color: #ffffff;
    border: 1px solid $border_strong;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 500;
}
